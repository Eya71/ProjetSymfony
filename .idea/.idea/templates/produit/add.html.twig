{% extends 'base.html.twig' %}

{% block title %}IMPORTY : Ajouter un produit{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/demande.css') }}">
{% endblock %}

{% block body %}
    <main class="demande-page">
        <div class="demande-container">
            <h1>Ajouter un produit</h1>

            {% for message in app.flashes('success') %}
                <div class="account-message success-message">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="account-message error-message">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('produit_store') }}" enctype="multipart/form-data" class="demande-form">
                <input type="text" name="nom_produit" placeholder="Nom du produit" required>
                <input type="number" name="prix" step="0.01" min="0" placeholder="Prix (DT)" required>
                <input type="number" name="quantite" min="1" value="1" placeholder="Quantité" required>
                <input type="text" name="categorie" placeholder="Catégorie" required>
                <textarea name="description" placeholder="Description" required></textarea>
                <input type="file" name="image" accept="image/*" required>
                <button type="submit" class="primary-btn">Ajouter</button>
            </form>
        </div>
    </main>
{% endblock %}
