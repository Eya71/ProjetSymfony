<header class="top-header simple-client-header">

    <button id="menuBtn" class="menu-btn" type="button" aria-label="Ouvrir le menu">
        <i class="fa-solid fa-align-justify"></i>
    </button>

    <a class="logo" href="{{ path('vendeur_dashboard') }}" aria-label="Importy - Espace vendeur">
        <img class="logo-img" src="{{ asset('files_profil/logo.png') }}" alt="Importy">
    </a>

    <div class="icons quick-actions">

        <a href="{{ path('app_vendeur_commandes') }}" class="icon-item">
            <i class="fa-solid fa-handshake" style="color:#B197FC;"></i>
            <span>Mes commandes</span>
        </a>

        <a href="{{ path('app_vendeur_offres') }}" class="icon-item">
            <i class="fa-solid fa-paper-plane" style="color:#B197FC;"></i>
            <span>Mes offres</span>
        </a>

        <a href="{{ path('app_vendeur_notifications') }}" class="icon-item">
            <i class="fa-solid fa-bell" style="color:#74C0FC;"></i>
            <span>Notifications</span>

            {% if notifCount is defined and notifCount > 0 %}
                <span class="badge">{{ notifCount }}</span>
            {% endif %}
        </a>

        <a href="{{ path('app_vendeur_messages') }}" class="icon-item">
            <i class="fa-solid fa-envelope" style="color:#B197FC;"></i>
            <span>Messages</span>

            {% if messageCount is defined and messageCount > 0 %}
                <span class="badge">{{ messageCount }}</span>
            {% endif %}
        </a>

        <a href="#mes-produits" class="icon-item">
            <i class="fa-solid fa-box-open" style="color:#B197FC;"></i>
            <span>Mes produits</span>
        </a>

        <a href="{{ path('app_vendeur_compte') }}" class="icon-item">
            <i class="fa-regular fa-user" style="color:#74C0FC;"></i>
            <span>Mon compte</span>
        </a>

        <a href="{{ path('app_logout') }}" class="icon-item">
            <i class="fa-solid fa-right-from-bracket" style="color:#74C0FC;"></i>
            <span>Logout</span>
        </a>

    </div>

</header>