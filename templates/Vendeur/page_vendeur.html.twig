{% extends 'base.html.twig' %}



{% block body %}
{% include %}
<main class="client-page simple-client-page vendeur-main">
    <section class="client-content full-width-content">
        <div class="welcome-banner simple-banner">
            <div class="welcome-user">
                {% if vendeur.idPhoto %}
                    <img
                            class="account-avatar-image welcome-avatar-image"
                            src="<?= htmlspecialchars($photoUrl) ?>"
                            alt="Photo de profil de {{ vendeur.username }}"
                    >
                {% else %}
                    <div class="avatar-circle welcome-avatar">{{ vendeur.username|first|upper }}</div>
                {% endif %}
                <div class="welcome-copy">
                    <p class="welcome-label">Bienvenue</p>
                    <h1>{{ vendeur.username }}</h1>
                    <p>Publiez vos produits, consultez vos annonces et repondez aux demandes clients.</p>
                </div>
            </div>
        </div>

        <section class="content-card">
            <div class="section-head">
                <h2>Publier un produit</h2>
            </div>
            <form action="/php/add_product.php" method="post" enctype="multipart/form-data">
                <input type="text" name="nom_produit" placeholder="Nom du produit" required>
                <input type="number" step="0.01" min="1" name="prix" placeholder="Prix" required>
                <input type="number" name="quantite" min="0" placeholder="Quantite" value="1" required>
                <select name="categorie" required>
                    <option value="tous">Tous</option>
                    <option value="femme">Femme</option>
                    <option value="homme">Homme</option>
                    <option value="maison">Maison</option>
                    <option value="beaute">Beaute</option>
                </select>
                <textarea name="description" rows="3" placeholder="Description"></textarea>
                <input type="file" name="image" accept="image/*">
                <button type="submit">Poster produit</button>
            </form>
        </section>

        <section class="content-card" id="mes-produits">
            <div class="section-head">
                <h2>Mes produits postes</h2>
                <p>{{ myProduits|length }} produit(s)</p>
            </div>
            {% if app.flashes('success') %}
                <div class="alert alert-success">
                    {{ app.flashes('success')|first }}
                </div>
            {% endif %}

            {% if produits is not empty %}
            <div class="cards">
                {% for p in myProduits %}
                    <article class="inner-card">

                        {% set prodImage = resolveImagePath(p.image_path ?? '') %}
                        {% if prodImage != '' %}
                            <img class="prod-img" src="{{ prodImage|e }}" alt="Produit">
                        {% else %}
                            <img class="prod-img" src="asset{{ file_profil/logo.png }}" alt="Produit">
                        {% endif %}
                        <h3>{{ p.nom_produit|e }}</h3>
                        <p class="meta">{{ p.categorie|e }} | {{ p.prix|e }} TND | {{ p.created_at|e }}</p>
                        <p><strong>Stock :</strong> {{ p.quantite > 0 ? (p.quantite ~ ' disponible(s)') : 'Rupture de stock' }}</p>
                        <p>{{ p.description|e }}</p>
                        <div class="product-actions">
                            <a href="{{ path('vendeur_edit_product', {id: produit.id}) }}" class="secondary-btn">Modifier</a>
                            <form action="{{ path('vendeur_delete_product', {id: produit.id}) }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');">
                                <button type="submit" class="small-btn btn-danger">Supprimer</button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>
            {% if myProduits is empty %}
                <p>Aucun produit poste pour le moment.</p>
            {% endif %}
        </section>
        <!-- Demandes clients -->
        <section class="content-card">
            <div class="section-head">
                <h2>Demandes clients</h2>
                <p>Vous pouvez proposer un deal</p>
            </div>
            {% if demandes is not empty %}
            <div class="cards">
                {% for demande in demandes %}
                    <article class="inner-card">
                        {% if demande.idPhoto %}
                            <img class="dem-img" src="{{ demande.idPhoto }}" alt="Demande">
                        {% endif %}
                        <h3>{{ demande.nomProduit }}</h3>
                        <p class="meta">
                            Client: {{ demande.username }} | Budget: {{ demande.prix }} TND |
                            Date: {{ demande.createdAt|date('d/m/Y') }}
                        </p>
                        <p>{{ demande.description }}</p>
                        <form method="POST" action="{{ path('vendeur_send_offer') }}" class="offer-form">
                            <input type="hidden" name="id_demande" value="{{ demande.id }}">
                            <input type="number" name="prix_propose" min="1" step="0.01" placeholder="Votre prix proposé" required>
                            <textarea name="message" rows="2" placeholder="Votre message..." required></textarea>
                            <button type="submit" class="btn btn-primary">Envoyer une offre</button>
                        </form>
                    </article>
                {% endfor %}
            </div>
        </section>
    </section>
</main>

<script src="{{ asset('js/vendeur.js') }}" defer> </script>
</body>

</html>