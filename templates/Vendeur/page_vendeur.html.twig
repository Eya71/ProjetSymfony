
{% extends 'partials/vendeur_layouts.html.twig' %}



{% block page_content %}
    <main class="client-page simple-client-page vendeur-main">
        <section class="client-content full-width-content">
            <div class="welcome-banner simple-banner">
                <div class="welcome-user">
                    {% if vendeur.idPhoto is defined and vendeur.idPhoto%}
                        <img class="account-avatar-image welcome-avatar-image" src="{{ asset(vendeur.idPhoto) }}" alt="Photo de profil de {{ vendeur.username }}">
                    {% else %}
                        <div class="avatar-circle welcome-avatar">{{ vendeur.username|first|upper }}</div>
                    {% endif %}
                    <div class="welcome-copy">
                        <p class="welcome-label">Bienvenue</p>
                        <h1>{{ vendeur.username }}</h1>
                        <p>Publiez vos produits, consultez vos annonces et répondez aux demandes clients.</p>
                    </div>
                </div>
            </div>

            <section class="content-card">
                <div class="section-head">
                    <h2>Publier un produit</h2>
                </div>

                <form action="{{ path('vendeur_dashboard') }}" method="post" enctype="multipart/form-data">
                    <input type="text" name="nom_produit" placeholder="Nom du produit" required>
                    <input type="number" step="0.01" min="0.01" name="prix" placeholder="Prix" required>
                    <input type="number" name="quantite" min="0" placeholder="Quantité" value="1" required>
                    <select name="categorie" required>
                        <option value="">Sélectionnez une catégorie</option>
                        <option value="femme">Femme</option>
                        <option value="homme">Homme</option>
                        <option value="maison">Maison</option>
                        <option value="beaute">Beauté</option>
                    </select>
                    <textarea name="description" rows="3" placeholder="Description"></textarea>
                    <input type="file" name="image" accept="image/*">
                    <button type="submit" class="btn btn-primary">Poster produit</button>
                </form>
            </section>

            <section class="content-card" id="mes-produits">
                <div class="section-head">
                    <h2>Mes produits postés</h2>
                    <p>{{ produits is defined ? produits|length : 0 }} produit(s)</p>
                </div>
                <div class="category-buttons" data-target="produit-card">
                    <button type="button" class="category-btn active" data-categorie="all">Tous</button>
                    <button type="button" class="category-btn" data-categorie="femme">Femme</button>
                    <button type="button" class="category-btn" data-categorie="homme">Homme</button>
                    <button type="button" class="category-btn" data-categorie="maison">Maison</button>
                    <button type="button" class="category-btn" data-categorie="beaute">Beauté</button>
                </div>

                {% if produits is defined and produits is not empty %}
                    <div class="cards">
                        {% for produit in produits %}
                            <article class="inner-card produit-card" data-categorie="{{ produit.categorie|lower }}">

                                <span class="product-badge">
                                     {{ produit.categorie }}
                                </span>

                                <div class="product-image">
                                    {% if produit.imagePath %}
                                        <img src="{{ asset(produit.imagePath) }}" alt="{{ produit.nomProduit }}">
                                    {% else %}
                                        <img src="{{ asset('files_profil/logo.png') }}" alt="Produit">
                                    {% endif %}
                                </div>

                                <h3>{{ produit.nomProduit }}</h3>
                                <p class="meta">
                                    {{ produit.prix }} TND
                                    {% if produit.createdAt %} | {{ produit.createdAt|date('d/m/Y') }}{% endif %}
                                </p>

                                <p><strong>Stock :</strong>
                                    {% if produit.quantite > 0 %}
                                        {{ produit.quantite }} disponible(s)
                                    {% else %}
                                        Rupture de stock
                                    {% endif %}
                                </p>

                                <p>{{ produit.description }}</p>

                                <div class="product-actions">
                                    <a href="{{ path('vendeur_edit_product', {id: produit.id}) }}" class="secondary-btn">Modifier</a>

                                    <form action="{{ path('vendeur_delete_product', {id: produit.id}) }}" method="POST" onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');" style="display:inline-block;">
                                        <button type="submit" class="small-btn btn-danger">Supprimer</button>
                                    </form>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="empty-message">Aucun produit posté pour le moment.</p>
                {% endif %}
            </section>

            <section class="content-card" id="demandes-clients">
                <div class="section-head">
                    <h2>Demandes clients</h2>
                    <p>Vous pouvez proposer un deal</p>
                </div>
                <div class="category-buttons" data-target="demande-card">
                    <button type="button" class="category-btn active" data-categorie="all">Tous</button>
                    <button type="button" class="category-btn" data-categorie="femme">Femme</button>
                    <button type="button" class="category-btn" data-categorie="homme">Homme</button>
                    <button type="button" class="category-btn" data-categorie="maison">Maison</button>
                    <button type="button" class="category-btn" data-categorie="beaute">Beauté</button>
                </div>

                {% if demandes is defined and demandes is not empty %}
                    <div class="cards">
                        {% for demande in demandes %}
                            <article class="inner-card demande-card" data-categorie="{{ demande.categorie|lower }}">
                                <span class="product-badge">
                                    {{ demande.categorie }}
                                </span>
                                {% if demande.idPhoto %}
                                    {% if demande.lienProduit %}
                                        <a href="{{ demande.lienProduit }}" target="_blank" class="demande-image-link">
                                            <div class="product-image">
                                                <img src="{{ asset(demande.idPhoto) }}" alt="{{ demande.nomProduit }}">
                                            </div>
                                        </a>
                                    {% else %}
                                        <div class="product-image">
                                            <img src="{{ asset(demande.idPhoto) }}" alt="{{ demande.nomProduit }}">
                                        </div>
                                    {% endif %}
                                {% endif %}
                                <h3>{{ demande.nomProduit }}</h3>
                                <p class="meta">
                                    Client: {{ demande.username is defined and demande.username.username is defined ? demande.username.username : 'Client' }}
                                    | Budget: {{ demande.prix }} TND
                                </p>
                                {% if demande.lienProduit %}
                                    <a href="{{ demande.lienProduit }}" target="_blank" class="secondary-btn">
                                        Ouvrir lien
                                    </a>
                                {% endif %}
                                <p>{{ demande.description }}</p>

                                <form method="POST" action="{{ path('vendeur_send_offer') }}" class="offer-form">
                                    <input type="hidden" name="id_demande" value="{{ demande.id }}">
                                    <input type="number" name="prix_propose" min="0.01" step="0.01" placeholder="Votre prix proposé" required>
                                    <textarea name="message" rows="2" placeholder="Votre message..." required></textarea>
                                    <button type="submit" class="btn btn-primary">Envoyer une offre</button>
                                </form>
                            </article>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="empty-message">Aucune demande pour le moment.</p>
                {% endif %}
            </section>
        </section>
    </main>
    <a href="{{ path('app_vendeur_commandes') }}" class="floating-cart-btn" aria-label="Voir les commandes">
        <i class="fa-solid fa-handshake"></i>
    </a>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const buttonGroups = document.querySelectorAll('.category-buttons');

            buttonGroups.forEach(function (group) {
                const targetClass = group.dataset.target;
                const buttons = group.querySelectorAll('.category-btn');
                const cards = document.querySelectorAll('.' + targetClass);

                buttons.forEach(function (button) {
                    button.addEventListener('click', function () {
                        const selectedCategory = this.dataset.categorie.toLowerCase();

                        buttons.forEach(function (btn) {
                            btn.classList.remove('active');
                        });

                        this.classList.add('active');

                        cards.forEach(function (card) {
                            const cardCategory = card.dataset.categorie.toLowerCase();

                            if (selectedCategory === 'all' || cardCategory === selectedCategory) {
                                card.style.display = '';
                            } else {
                                card.style.display = 'none';
                            }
                        });
                    });
                });
            });
        });
    </script>
{% endblock %}