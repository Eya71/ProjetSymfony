{% extends 'partials/vendeur_layouts.html.twig' %}

{% block title %}Modification Produit{% endblock %}

{% block page_content %}
    <main class="client-page simple-client-page vendeur-main">
        <section class="client-content full-width-content">

            <section class="content-card">
                <div class="section-head">
                    <h2>Modifier le produit</h2>
                    <p>Changez les informations du produit puis enregistrez.</p>
                </div>

                <form action="{{ path('vendeur_edit_product', {id: produit.id}) }}"
                      method="post"
                      enctype="multipart/form-data"
                      class="edit-product-form">

                    <div class="edit-product-layout">

                        <div class="edit-product-left">
                            <h3>Image du produit</h3>

                            {% if produit.imagePath %}
                                <div class="edit-product-image">
                                    <img id="previewImage"
                                         src="{{ asset(produit.imagePath) }}"
                                         alt="{{ produit.nomProduit }}">
                                </div>
                            {% else %}
                                <div class="edit-product-image">
                                    <img id="previewImage"
                                         src="{{ asset('files_profil/logo.png') }}"
                                         alt="Produit">
                                </div>
                            {% endif %}

                            <label for="imageInput" class="edit-file-label" >
                                Changer l’image
                            </label>

                            <input id="imageInput"
                                   class="hidden-file-input"
                                   type="file"
                                   name="image"
                                   accept="image/*">
                        </div>

                        <div class="edit-product-right">

                            <input
                                    type="text"
                                    name="nom_produit"
                                    value="{{ produit.nomProduit }}"
                                    placeholder="Nom du produit"
                                    required
                            >

                            <input
                                    type="number"
                                    step="0.01"
                                    min="0.01"
                                    name="prix"
                                    value="{{ produit.prix }}"
                                    placeholder="Prix"
                                    required
                            >

                            <input
                                    type="number"
                                    name="quantite"
                                    min="0"
                                    value="{{ produit.quantite }}"
                                    placeholder="Quantité"
                                    required
                            >

                            <select name="categorie" required>
                                <option value="">Sélectionnez une catégorie</option>
                                <option value="femme" {% if produit.categorie == 'femme' %}selected{% endif %}>Femme</option>
                                <option value="homme" {% if produit.categorie == 'homme' %}selected{% endif %}>Homme</option>
                                <option value="maison" {% if produit.categorie == 'maison' %}selected{% endif %}>Maison</option>
                                <option value="beaute" {% if produit.categorie == 'beaute' %}selected{% endif %}>Beauté</option>
                            </select>

                            <textarea name="description"
                                      rows="5"
                                      placeholder="Description">{{ produit.description }}</textarea>

                            <div class="product-actions">
                                <button type="submit" class="primary-btn">
                                    Enregistrer les modifications
                                </button>

                                <a href="{{ path('vendeur_dashboard') }}" class="secondary-btn">
                                    Annuler
                                </a>
                            </div>

                        </div>

                    </div>
                </form>
            </section>

        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageInput = document.getElementById('imageInput');
            const previewImage = document.getElementById('previewImage');

            imageInput.addEventListener('change', function () {
                const file = this.files[0];

                if (file) {
                    previewImage.src = URL.createObjectURL(file);
                }
            });
        });
    </script>
{% endblock %}