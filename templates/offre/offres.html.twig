
{% extends 'partials/client_layout.html.twig' %}

{% block stylesheets %}

    {{ parent() }}

    <link rel="stylesheet"
          href="{{ asset('css/offres.css') }}">

{% endblock %}

{% block page_title %}

    Les offres

{% endblock %}

{% block page_content %}

    <div class="offers-container">

        {% for offre in offres %}

            <div class="offer-card">

                <!-- TOP -->
                <div class="offer-top">

                    <div class="vendeur-info">

                        <img src="{{ asset(offre.vendeurUsername.idPhoto) }}"
                             class="avatar"
                             alt="vendeur">

                        <div class="vendeur-details">

                            <a href="{{ path('app_vendor_profile_client', {
                                'username': offre.vendeurUsername.username
                            }) }}"
                               class="vendeur-name">

                                {{ offre.vendeurUsername.username }}

                            </a>

                            <span class="seller-badge">

                            Vendeur vérifié

                        </span>

                        </div>

                    </div>

                    <div class="price-box">

                        {{ offre.prixPropose }} TND

                    </div>

                </div>

                <!-- MESSAGE -->
                <div class="message-box">

                    {{ offre.message }}

                </div>

                <!-- ACTIONS -->
                <div class="actions">

                    <form method="POST"
                          action="{{ path('accepter_offre') }}">

                        <input type="hidden"
                               name="id"
                               value="{{ offre.id }}">

                        <button class="btn-accept">

                            Accepter l'offre

                        </button>

                    </form>

                    <a href="#"
                       class="btn-chat">

                        Chat

                    </a>

                </div>

            </div>

        {% else %}

            <div class="empty-offers">

                <div class="empty-icon">

                    <i class="fa-regular fa-envelope-open"></i>

                </div>

                <h3>

                    Aucune offre pour le moment

                </h3>

                <p>

                    Les vendeurs n'ont pas encore proposé
                    d'offres pour cette demande.

                </p>

            </div>

        {% endfor %}

    </div>


{% endblock %}
