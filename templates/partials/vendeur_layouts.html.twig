{# templates/partials/vendeur_layouts.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Importy - Espace vendeur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/vendeur_style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/page_vendeur.css') }}">
{% endblock %}

{% block body %}
    {# Header / menu — utilisez un partial header corrigé si disponible #}
    {% include 'partials/vendeur_header.html.twig' %}

    {# Sidebar vendeur (partial déjà présent dans votre projet) #}
    {% include 'partials/_sidebar_vendeur.html.twig' %}

    {# Flash messages #}
    {% for message in app.flashes('error') %}
        <div class="flash-error">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('success') %}
        <div class="flash-success">{{ message }}</div>
    {% endfor %}

    <main class="page-wrapper">
        <section class="page-header">
            <h1 class="page-title">{% block page_title %}{% endblock %}</h1>
        </section>

        <section class="page-content">
            {% block page_content %}{% endblock %}
        </section>
    </main>

    {% include 'partials/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/menu.js') }}"></script>
    <script src="{{ asset('js/vendeur.js') }}"></script>
{% endblock %}