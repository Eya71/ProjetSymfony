{% extends 'base.html.twig' %}

{% block title %}
    Produits
{% endblock %}

{% block stylesheets %}

    <link rel="stylesheet"
          href="{{ asset('css/style.css') }}">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

{% endblock %}


{% block body %}

    {% include 'partials/_header_client.html.twig' %}

    {% include 'partials/_sidebar_client.html.twig' %}

    <div class="hero">

        <img src="{{ asset('files_profil/img.png') }}"
             alt="promo"
             class="hero-img">

    </div>

    <main class="client-page simple-client-page">

        <section class="client-content full-width-content">

            <section class="content-card"
                     id="produits">

                <div class="section-head">

                    <h2>

                        Produits

                    </h2>

                    <p>

                        {{ produits|length }} résultat(s)

                    </p>

                </div>

                <div class="products-grid"
                     id="productsGrid">

                    {% if produits is not empty %}

                        {% for prod in produits %}

                            <article class="product-card searchable-product">

                                <span class="product-badge">

                                    {{ prod.categorie }}

                                </span>

                                <div class="product-image">

                                    <img src="{{ asset(prod.imagePath) }}"
                                         alt="{{ prod.nomProduit }}">

                                </div>

                                <h3>

                                    {{ prod.nomProduit }}

                                </h3>

                                <p>

                                    <strong>Prix :</strong>

                                    {{ prod.prix }} DT

                                </p>

                                <div class="product-actions">

                                    <a class="small-btn"
                                       href="{{ path('produit_details', {'id': prod.id}) }}">

                                        Voir produit

                                    </a>

                                    <form action="#"
                                          method="post">

                                        <input type="hidden"
                                               name="id_produit"
                                               value="{{ prod.id }}">

                                        <button class="primary-btn product-cart-btn"
                                                type="submit">

                                            Ajouter au panier

                                        </button>

                                    </form>

                                </div>

                            </article>

                        {% endfor %}

                    {% else %}

                        <p class="empty-products">

                            Aucun produit trouvé.

                        </p>

                    {% endif %}

                </div>

            </section>

        </section>

    </main>

    <a href="#"
       class="floating-cart-btn">

        <i class="fa-solid fa-bag-shopping"></i>

    </a>

    {% include 'partials/_footer.html.twig' %}

    <script src="{{ asset('js/menu.js') }}"></script>

{% endblock %}