{% extends 'partials/client_layout.html.twig' %}

{% block stylesheets %}

    {{ parent() }}

    <link rel="stylesheet"
          href="{{ asset('css/demande.css') }}">

{% endblock %}

{% block page_title %}

    Mon panier

{% endblock %}

{% block page_content %}

    <main class="panier-page">
        <div class="panier-layout">
            <div class="panier-left">
                <section class="content-card panier-card">
                    <div class="section-head">
                        <div>
                            <h2>Mon panier</h2>
                            <p>{{ items|length }} produit(s)</p>
                        </div>
                    </div>

                    {% for message in success %}
                        <div class="account-message success-message">{{ message }}</div>
                    {% endfor %}

                    {% for message in errors %}
                        <div class="account-message error-message">{{ message }}</div>
                    {% endfor %}

                    {% include 'panier/_items.html.twig' %}
                </section>
            </div>

            <div class="panier-right">
                <div class="resume-card">
                    <h3>Récapitulatif</h3>

                    <div class="resume-line">
                        <span>Sous-total</span>
                        <span>{{ total|number_format(2, '.', ' ') }} DT</span>
                    </div>

                    <div class="resume-line">
                        <span>Livraison</span>
                        <span>Calculé à l'étape paiement</span>
                    </div>

                    <div class="resume-line total">
                        <span>Total</span>
                        <span>{{ total|number_format(2, '.', ' ') }} DT</span>
                    </div>

                    <form action="{{ path('panier_validate') }}" method="post">
                        <button type="submit" class="btn-checkout">
                            Valider mon panier
                        </button>
                    </form>
                </div>

                <a href="{{ path('mes_commandes') }}" class="orders-shortcut-card">
                    <div class="orders-shortcut-top">
                        <span class="orders-shortcut-icon"><i class="fa-solid fa-box-open"></i></span>
                        <span class="orders-shortcut-badge">{{ ordersCount }}</span>
                    </div>
                    <h3>Mes commandes</h3>
                    <p>Retrouver toutes les commandes validées depuis votre panier et suivre leur statut.</p>
                    <span class="orders-shortcut-link">Voir mes commandes <i class="fa-solid fa-arrow-right"></i></span>
                </a>
            </div>
        </div>
    </main>


{% endblock %}
