{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}?v=sidebar-fix-3">
    <link rel="stylesheet" href="{{ asset('css/mes_demandes.css') }}">
{% endblock %}

{% block body %}
    <header class="top-header simple-client-header">
        <div class="header-left">
            <a href="{{ path('app_client_interface') }}" class="logo">
                <img src="{{ asset('files_profil/logo.png') }}" alt="Importy" class="logo-img">
            </a>
        </div>

        <div class="header-center">
            <h1 class="title">Mon panier</h1>
        </div>

        <div class="icons quick-actions">
            <a href="{{ path('app_client_profile') }}" class="icon-item">
                <i class="fa-regular fa-user" style="color:#B197FC;"></i>
                <span>Mon compte</span>
            </a>
            <a href="#" class="icon-item">
                <i class="fa-solid fa-list-check" style="color:#74C0FC;"></i>
                <span>Mes demandes</span>
            </a>
            <a href="#" class="icon-item">
                <i class="fa-solid fa-plus" style="color:#74C0FC;"></i>
                <span>Demande</span>
            </a>
            <a href="{{ path('app_client_interface') }}" class="icon-item">
                <i class="fa-solid fa-home" style="color:#74C0FC;"></i>
                <span>acceuil</span>
            </a>
        </div>
    </header>

    <main class="panier-page">
        <div class="panier-layout">
            <div class="panier-left">
                <section class="content-card panier-card">
                    <div class="section-head">
                        <div>
                            <h2>Mon panier</h2>
                            <p>{{ items|length }} produit(s)</p>
                        </div>
                    </div>

                    {% for message in success %}
                        <div class="account-message success-message">{{ message }}</div>
                    {% endfor %}

                    {% for message in errors %}
                        <div class="account-message error-message">{{ message }}</div>
                    {% endfor %}

                    {% include 'panier/_items.html.twig' %}
                </section>
            </div>

            <div class="panier-right">
                <div class="resume-card">
                    <h3>Récapitulatif</h3>

                    <div class="resume-line">
                        <span>Sous-total</span>
                        <span>{{ total|number_format(2, '.', ' ') }} DT</span>
                    </div>

                    <div class="resume-line">
                        <span>Livraison</span>
                        <span>Calculé à l'étape paiement</span>
                    </div>

                    <div class="resume-line total">
                        <span>Total</span>
                        <span>{{ total|number_format(2, '.', ' ') }} DT</span>
                    </div>

                    <form action="{{ path('panier_validate') }}" method="post">
                        <button type="submit" class="btn-checkout">
                            Valider mon panier
                        </button>
                    </form>
                </div>

                <a href="#" class="orders-shortcut-card">
                    <div class="orders-shortcut-top">
                        <span class="orders-shortcut-icon"><i class="fa-solid fa-box-open"></i></span>
                        <span class="orders-shortcut-badge">{{ ordersCount }}</span>
                    </div>
                    <h3>Mes commandes</h3>
                    <p>Retrouver toutes les commandes validées depuis votre panier et suivre leur statut.</p>
                    <span class="orders-shortcut-link">Voir mes commandes <i class="fa-solid fa-arrow-right"></i></span>
                </a>
            </div>
        </div>
    </main>

    <div class="about-site">
        <h4><strong>A propos de nous</strong></h4>
        <p>
            Importy est un site de vente en ligne qui permet de découvrir et d’acheter
            facilement différents produits dans plusieurs catégories

            Importy vise à offrir une expérience d’achat fluide et sécurisée, avec un large choix de produits
            pour répondre aux attentes de tous les clients.
        </p>
    </div>

    <div class="services">
        <div class="service">
            <div class="icon"><i class="fa-solid fa-store"></i></div>
            <div>
                <h4>pour les vendeurs</h4>
                <p>Proposez vos produits et gérez votre activité en toute simplicité.</p>
            </div>
        </div>

        <div class="service">
            <div class="icon"><i class="fa-solid fa-truck"></i></div>
            <div>
                <h4>Livraison standard offerte</h4>
                <p>just verifier votre adresse dans le compte</p>
            </div>
        </div>

        <div class="service">
            <div class="icon"><i class="fa-regular fa-credit-card"></i></div>
            <div>
                <h4>Paiements a la livraison</h4>
                <p>vous payez le livreur lorsque vous recevez votre commande</p>
            </div>
        </div>

        <div class="service">
            <div class="icon"><i class="fa-solid fa-undo"></i></div>
            <div>
                <h4>Retours</h4>
                <p>sous 14 jours</p>
            </div>
        </div>
    </div>
{% endblock %}
